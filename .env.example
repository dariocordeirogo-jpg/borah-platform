# Copie para .env.local e preencha. Nunca commite .env.local.
# Valores públicos (vão para o navegador; a segurança dos dados é feita pelo RLS):
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# URL pública do site. Em produção: https://zexi.com.br (só depois do domínio apontado para a Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredos (só no servidor, nunca com prefixo NEXT_PUBLIC_).
# ZEXI PAY (Stripe). Sem a chave, o pagamento online aparece como "em configuração".
# Use sk_test_ para desenvolver. sk_live_ só funciona com a flag `payments` ligada no banco (autorização explícita).
STRIPE_SECRET_KEY=
# Segredo de assinatura do webhook (Stripe → Developers → Webhooks). O MESMO valor vai no Vault do Supabase
# com o nome stripe_webhook_secret (ver docs/PAYMENTS.md).
STRIPE_WEBHOOK_SECRET=

# IA (Claude). Sem a chave, a IA aparece como "em configuração". Ver docs/AI.md.
ANTHROPIC_API_KEY=

# Transmissão das lives (Mux → Settings → Access Tokens, permissão Mux Video). Sem elas, a loja cola um link HLS.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
