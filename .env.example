# Copie para .env.local e preencha. Nunca commite .env.local.
# Valores públicos (vão para o navegador; a segurança dos dados é feita pelo RLS):
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# URL pública do site. Em produção: https://livelance.com.br (só depois do domínio apontado para a Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredos (só no servidor, nunca com prefixo NEXT_PUBLIC_). Ainda não usados.
# SUPABASE_SECRET_KEY=
